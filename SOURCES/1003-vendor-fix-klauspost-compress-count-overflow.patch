From 82632f3774316d48be0eaa47555892f908abd6c7 Mon Sep 17 00:00:00 2001
From: Klaus Post <klauspost@gmail.com>
Date: Mon, 12 Oct 2026 10:35:05 +0200
Subject: [PATCH] fse/huff0: reject invalid counts and limit FSE tableLog of
 Huffman weights

* fse: reject normalized counts that do not fit in int16

readNCount accepts tableLog 15, where one symbol can be given all 1<<15
states. That count was stored in norm as int16 -32768, so buildDtable
spread no symbols, the position check still passed, and the decoding
table kept the cells of the previous table decoded on the same Scratch.
Cells with nbBits 0 then reached nextFast, which read 16 junk bits into
the state and indexed past the table.

* huff0: limit the FSE tableLog of Huffman weights to 6

RFC 8878 limits the accuracy log of FSE-compressed Huffman weights to 6
and the reference decoder rejects larger tables, so no valid stream uses
them. Reject them in ReadTable before decoding.

* fse: fix validateNorm count for negative entries

(cherry picked from commit 748550b77336a1720b51f574d344ab98422c5e2a)
---
 vendor/github.com/klauspost/compress/fse/compress.go     | 3 ++-
 vendor/github.com/klauspost/compress/fse/decompress.go   | 6 ++++++
 vendor/github.com/klauspost/compress/huff0/decompress.go | 4 ++++
 3 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/vendor/github.com/klauspost/compress/fse/compress.go b/vendor/github.com/klauspost/compress/fse/compress.go
index 8c8baa4..2a7cd68 100644
--- a/vendor/github.com/klauspost/compress/fse/compress.go
+++ b/vendor/github.com/klauspost/compress/fse/compress.go
@@ -659,7 +659,8 @@ func (s *Scratch) validateNorm() (err error) {
 		if v >= 0 {
 			total += int(v)
 		} else {
-			total -= int(v)
+			// -1 takes one cell. Adding -v would let a wrapped -32768 pass.
+			total++
 		}
 	}
 	defer func() {
diff --git a/vendor/github.com/klauspost/compress/fse/decompress.go b/vendor/github.com/klauspost/compress/fse/decompress.go
index 0c7dd4f..85b55db 100644
--- a/vendor/github.com/klauspost/compress/fse/decompress.go
+++ b/vendor/github.com/klauspost/compress/fse/decompress.go
@@ -3,6 +3,7 @@ package fse
 import (
 	"errors"
 	"fmt"
+	"math"
 )
 
 const (
@@ -123,6 +124,11 @@ func (s *Scratch) readNCount() error {
 			remaining -= count
 			gotTotal += count
 		}
+		if count > math.MaxInt16 {
+			// Only one symbol filling a tableLog 15 table, which cannot be decoded.
+			// Truncated, it would leave the decoding table unwritten.
+			return fmt.Errorf("corruption detected (count %d > %d)", count, math.MaxInt16)
+		}
 		s.norm[charnum&0xff] = int16(count)
 		charnum++
 		previous0 = count == 0
diff --git a/vendor/github.com/klauspost/compress/huff0/decompress.go b/vendor/github.com/klauspost/compress/huff0/decompress.go
index 7d0efa8..4832c96 100644
--- a/vendor/github.com/klauspost/compress/huff0/decompress.go
+++ b/vendor/github.com/klauspost/compress/huff0/decompress.go
@@ -54,6 +54,10 @@ func ReadTable(in []byte, s *Scratch) (s2 *Scratch, remain []byte, err error) {
 		if len(in) < int(iSize) {
 			return s, nil, fmt.Errorf("input too small for table, want %d bytes, have %d", iSize, len(in))
 		}
+		// The low nibble is the weights' FSE tableLog - 5, which the format limits to 6.
+		if in[0]&15+5 > 6 {
+			return s, nil, errors.New("corrupt input: weights tableLog too big")
+		}
 		// FSE compressed weights
 		s.fse.DecompressLimit = 255
 		hw := s.huffWeight[:]
